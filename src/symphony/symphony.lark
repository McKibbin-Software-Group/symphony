SUM: "sum"
PROD: "prod"
INCLUDE: "include"
MEMBER: "member"
CATEGORY: "category"
DIMENSION: "dimension"
DOMAIN: "domain"
PARAMETER: "parameter"
VARIABLE: "variable"
UNIT: "unit"
DEVIATION_UNIT: "deviation_unit"
EQUATION: "equation"
LOGGED: "logged"
INTERTEMPORAL: "intertemporal"
LEFT_SQUARE_BRACKET: "["
RIGHT_SQUARE_BRACKET: "]"

LEFT_ROUND_BRACKET: "("
RIGHT_ROUND_BRACKET: ")"
CONDITIONAL: "|"
EQUALS: "="
NOT_EQUALS: "!="
PLUS: "+"
MINUS: "-"
MULTIPLY: "*"
DIVIDE: "/"

TRUE: "True" | "true"
FALSE: "False" | "false"
boolean: TRUE | FALSE

%import common.CNAME -> NAME
%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE
%import common.INT -> TUPLE_POSITION
%import common.NUMBER -> NUMBER

%ignore WS_INLINE
%ignore NEWLINE

// Line comments (allow both shell-style and C++-style comments)
%ignore /#[^\n]*/

// Triple-quoted documentation string (non-greedy, spans lines)
TRIPLE_STRING: /\"\"\"(.|\n|\r)*?\"\"\"/

FILE_PATH: ESCAPED_STRING

// ---------- Parser ----------

start: declaration+

?declaration: include_declaration
           | member_declaration
           | category_declaration
           | dimension_declaration
           | domain_declaration
           | parameter_declaration
           | variable_declaration
           | equation_declaration
           | unit_declaration

include_declaration: INCLUDE FILE_PATH

member_declaration:     MEMBER  NAME ":" label documentation?
category_declaration:   CATEGORY NAME ":" label member_list documentation?
dimension_declaration:  DIMENSION NAME ":" label dimension_expression documentation?
domain_declaration:     DOMAIN NAME ":" label domain_expression? documentation?
parameter_declaration:  PARAMETER NAME ":" label (DOMAIN EQUALS domain_expression)? unit? documentation?
variable_declaration:   VARIABLE NAME ":" label (DOMAIN EQUALS domain_expression)? unit? deviation_unit? logged? intertemporal? documentation?
unit_declaration:       UNIT NAME ":" label documentation?
equation_declaration:   EQUATION ":" label domain_expression? equation_expression documentation?

label: ESCAPED_STRING

?documentation: TRIPLE_STRING

name_list: NAME ("," NAME)*

member_list: "[" name_list "]"

unit: UNIT EQUALS unit_reference 

deviation_unit: DEVIATION_UNIT EQUALS unit_reference

unit_reference: NAME

logged: LOGGED EQUALS boolean

intertemporal: INTERTEMPORAL EQUALS boolean

set_operator: PLUS | MINUS

// Dimension member expressions
dimension_expression: dimension_term (set_operator dimension_term)*

// A dimension_term is either a bracketed list of member names or 
// a reference to a previously-declared dimension or category using its NAME.
dimension_term: member_list
        | dimension_reference

dimension_reference: NAME

// Domains
domain_expression: "(" domain_term (set_operator domain_term)* ")"

domain_term: domain_list [ tuple_conditions ]

// A domain list is a singleton domain reference or 
// a list of one or more dimension references or 
// a list of one or more member references.
domain_list: name_list | member_list 

tuple_conditions: CONDITIONAL tuple_condition ("," tuple_condition)*

tuple_condition: TUPLE_POSITION (EQUALS|NOT_EQUALS) TUPLE_POSITION

// ---------------------------------------------------------
// Equation Expression Grammar (LALR-friendly)
// ---------------------------------------------------------

// Top-level equation: LHS = RHS
equation_expression: equality_expression

equality_expression: lhs_wrapped_variable EQUALS expression

lhs_wrapped_variable: lhs_variable_reference
                     | lhs_expectation
                     | lhs_lead 

lhs_variable_reference: NAME [domain_expression]

rhs_variable_reference: NAME ["(" rhs_variable_conditional ("," rhs_variable_conditional)* ")" ]
?rhs_variable_conditional: rhs_domain_restriction | rhs_dimension_matches | rhs_aggregation_matches
rhs_domain_restriction: "dom" "=" domain_expression
rhs_dimension_matches: "dim" "=" tuple_position_list
rhs_aggregation_matches: "agg" "=" tuple_position_list

tuple_position_list: dimension_reference ":" TUPLE_POSITION ("," dimension_reference ":" TUPLE_POSITION)*

// Root of arithmetic expression
?expression: sum_expression

// Addition and subtraction (left associative)
?sum_expression: product_expression ((PLUS | MINUS) product_expression)*

// Multiplication and division (left associative)
?product_expression: power_expression ((MULTIPLY | DIVIDE) power_expression)*

// Exponentiation (right associative)
?power_expression: unary_expression
                | unary_expression "^" power_expression

// Unary operators
?unary_expression: atom
                | PLUS unary_expression
                | MINUS unary_expression

// ---------------------------------------------------------
// Atomic expressions: constants, names, functions, brackets
// ---------------------------------------------------------
?atom: NUMBER
    | rhs_variable_reference
    | function
    | rhs_expectation
    | summation
    | product
    | LEFT_ROUND_BRACKET sum_expression RIGHT_ROUND_BRACKET

// ---------------------------------------------------------
// Function calls
// ---------------------------------------------------------
FUNCTION_NAME: "log" | "exp" | "lead" | "lag"

function: FUNCTION_NAME "(" sum_expression ")"

lhs_lead: "lead" "(" lhs_wrapped_variable RIGHT_ROUND_BRACKET ")"

// ---------------------------------------------------------
// Expectation operator
// ---------------------------------------------------------

rhs_expectation: "E" "(" rhs_variable_reference ")"
lhs_expectation: "E" "(" lhs_wrapped_variable ")"

// ---------------------------------------------------------
// Summation and Product across members at a specified
// tuple position within a domain.
// ---------------------------------------------------------

summation: SUM "(" dimension_reference "|" sum_expression ")"
product: PROD "(" dimension_reference "|" sum_expression ")"
