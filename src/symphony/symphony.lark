// ---------- Lexer ----------

%import common.CNAME -> NAME
%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE

%ignore WS_INLINE
%ignore NEWLINE

// Line comments (allow both shell-style and C++-style comments)
%ignore /#[^\n]*/
%ignore /\/\/[^\n]*/

// Triple-quoted documentation string (non-greedy, spans lines)
TRIPLE_STRING: /\"\"\"(.|\n|\r)*?\"\"\"/

// ---------- Parser ----------

start: declaration+

declaration: member_declaration
           | category_declaration
           | dimension_declaration
           | dimensions_declaration
           | domain_declaration
           | parameter_declaration
           | variable_declaration
           | equation_declaration

member_declaration:     "member"     NAME ":" label documentation?
category_declaration:   "category"   NAME ":" label name_list documentation?
dimension_declaration:  "dimension"  NAME ":" label dimension_expression documentation?
dimensions_declaration: "dimensions" NAME ":" label name_list documentation?
domain_declaration:     "domain"     NAME ":" label domain_expression? documentation?
parameter_declaration:  "parameter"  NAME ":" label units documentation?
variable_declaration:   "variable"   NAME ":" label units deviation_units domain_declaration? logged? intertemporal? documentation?
equation_declaration:   "equation"   NAME ":" label equation_expression documentation?

units: "units" "=" NAME
deviation_units: "deviation_units" "=" NAME

logged: "logged" ["=" ("true"|"false")]

intertemporal: "intertemporal" ["=" ("true"|"false")]

label: ESCAPED_STRING
documentation: TRIPLE_STRING

SET_OPERATOR: "+" | "-"

// Dimension member expressions
dimension_expression: dimension_term (SET_OPERATOR dimension_term)*

// A dimension_term is either a bracketed list of member names or 
// a reference to a previously-declared dimension or category using its NAME.
dimension_term: name_list
        | NAME -> dimension_reference

// Bracketed list of names 
name_list: "[" [NAME ("," NAME)*] "]"

// Domain expressions
domain_expression: domain_term (SET_OPERATOR domain_term)*

// A domain reference should be able to be a reference to either another domain or a "dimensions" declaration, noting that a dimensions implicitly defines a domain
domain_term: NAME -> domain_reference

// Equation expressions
equation_expression: "to be completed"
