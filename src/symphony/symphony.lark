// ---------- Lexer ----------

%import common.CNAME -> NAME
%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE

%ignore WS_INLINE
%ignore NEWLINE

// Line comments (allow both shell-style and C++-style comments)
%ignore /#[^\n]*/
%ignore /\/\/[^\n]*/

// Triple-quoted doc string (non-greedy, spans lines)
TRIPLE_STRING: /\"\"\"(.|\n|\r)*?\"\"\"/

// ---------- Parser ----------

start: declaration+

declaration: member_decl
           | category_decl
           | dimension_decl
           | dimensions_decl
           | parameter_decl
           | variable_decl
           | equation_decl

member_decl:     "member"     NAME ":" label doc?
category_decl:   "category"   NAME ":" label name_list doc?
dimension_decl:  "dimension"  NAME ":" label dimension_expression doc?
dimensions_decl: "dimensions" NAME ":" label name_list doc?
domain_decl:     "domain"     NAME ":" label domain_expression? doc?
parameter_decl:  "parameter"  NAME ":" label units doc?
variable_decl:   "variable"   NAME ":" label units deviation_units dimensions_decl logged? intertemporal? doc?
equation_decl:   "equation"   NAME ":" label equation_expression doc?

units: "units" "=" NAME
deviation_units: "deviation_units" "=" NAME

logged: "logged" ["=" ("true"|"false")]

intertemporal: "intertemporal" ["=" ("true"|"false")]

label: ESCAPED_STRING
doc: TRIPLE_STRING

// Dimension member expressions
dimension_expression: dimension_term (DIMENSION_OPERATOR dimension_term)*

DIMENSION_OPERATOR: "+" | "-"

// A dimension_term is either a bracketed list of member names or 
// a reference to a previously-declared dimension or category using its NAME.
dimension_term: name_list
        | NAME -> dimension_reference

// Bracketed list of names 
name_list: "[" [NAME ("," NAME)*] "]"

// Domain expressions
domain_expression: "to be completed"

// Equation expressions
equation_expression: "to be completed"
