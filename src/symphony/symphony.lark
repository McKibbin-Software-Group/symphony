// ---------- Lexer ----------

%import common.CNAME -> NAME
%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE
%import common.INT -> TUPLE_POSITION
%import common.NUMBER -> NUMBER

%ignore WS_INLINE
%ignore NEWLINE

// Line comments (allow both shell-style and C++-style comments)
%ignore /#[^\n]*/
%ignore /\/\/[^\n]*/

// Triple-quoted documentation string (non-greedy, spans lines)
TRIPLE_STRING: /\"\"\"(.|\n|\r)*?\"\"\"/

LEFT_SQUARE_BRACKET: "["
RIGHT_SQUARE_BRACKET: "]"

LEFT_ROUND_BRACKET: "("
RIGHT_ROUND_BRACKET: ")"
CONDITIONAL: "|"
EQUALS: "="
NOT_EQUALS: "!="
PLUS: "+"
MINUS: "-"

TRUE: "True" | "true"
FALSE: "False" | "false"

// ---------- Parser ----------

start: declaration+

declaration: member_declaration
           | category_declaration
           | dimension_declaration
           | domain_declaration
           | parameter_declaration
           | variable_declaration
           | equation_declaration

member_declaration:     "member"     NAME ":" label documentation?
category_declaration:   "category"   NAME ":" label member_list documentation?
dimension_declaration:  "dimension"  NAME ":" label dimension_expression documentation?
domain_declaration:     "domain"     NAME ":" label domain_expression? documentation?
parameter_declaration:  "parameter"  NAME ":" label units domain_expression? documentation?
variable_declaration:   "variable"   NAME ":" label units deviation_units domain_expression? logged? intertemporal? documentation?
equation_declaration:   "equation"   NAME ":" label domain_expression? equation_expression documentation?

label: ESCAPED_STRING

documentation: TRIPLE_STRING

name_list: NAME ("," NAME)*

# Domain list is a list of domains and/or dimension names.
domain_list: name_list

member_list: LEFT_SQUARE_BRACKET name_list RIGHT_SQUARE_BRACKET

units: "units" EQUALS NAME
deviation_units: "deviation_units" EQUALS NAME

logged: "logged" [EQUALS (TRUE | FALSE)]

intertemporal: "intertemporal" [EQUALS (TRUE | FALSE)]

SET_OPERATOR: PLUS | MINUS

// Dimension member expressions
dimension_expression: dimension_term (SET_OPERATOR dimension_term)*

// A dimension_term is either a bracketed list of member names or 
// a reference to a previously-declared dimension or category using its NAME.
dimension_term: member_list
        | NAME -> dimension_reference

dimension_function_conditions: 
// Domain expressions
// Every domain terms should be resolvable to a domain.
// The set operators enable domain calculations.
// Kinds of domain terms include:
// A reference to another named domain (a domain reference)
// A function of a list of dimensions (e.g. cartesian product of a list of dimensions)
// Note that a dimension can be specified by name or as a list of members.
// list of dimensions reference should be able to be a reference to either another domain or a "dimensions" declaration, noting that a dimensions implicitly defines a domain
domain_expression: domain_term (SET_OPERATOR domain_term)*
domain_term: LEFT_ROUND_BRACKET domain_list tuple_conditions? RIGHT_ROUND_BRACKET -> domain_function
        | NAME -> domain_reference

tuple_condition: TUPLE_POSITION (EQUALS|NOT_EQUALS) TUPLE_POSITION
tuple_conditions: CONDITIONAL tuple_condition ("," tuple_condition)*

// ---------------------------------------------------------
// Equation Expression Grammar
// ---------------------------------------------------------

// Top-level equation: LHS = RHS
equation_expression: equality_expression

lhs_variable_reference: NAME
rhs_variable_reference: NAME

equality_expression: lhs_variable_reference EQUALS sum_expression

// Addition and subtraction
sum_expression: product_expression
        | sum_expression PLUS product_expression
        | sum_expression MINUS product_expression

// Multiplication and division
product_expression: power_expression
            | product_expression "*" power_expression
            | product_expression "/" power_expression

// Exponentiation (right associative)
power_expression: unary_expression
          | unary_expression "^" power_expression
          | unary_expression "**" power_expression

// Unary operators
unary_expression: atom
          | PLUS unary_expression
          | MINUS unary_expression

// ---------------------------------------------------------
// Atomic expressions: constants, names, functions, brackets
// ---------------------------------------------------------
atom: NUMBER
    | rhs_variable_reference
    | function
    | expectation
    | sum
    | product
    | LEFT_ROUND_BRACKET equation_expression RIGHT_ROUND_BRACKET

// ---------------------------------------------------------
// Function calls
// ---------------------------------------------------------

FUNCTION_NAME: "log" | "exp" | "lead" | "lag"
function: FUNCTION_NAME LEFT_ROUND_BRACKET equation_expression RIGHT_ROUND_BRACKET

// Expectations E(expr) - used to identify expectations in period t of values in future periods.
expectation: "E" LEFT_ROUND_BRACKET equation_expression RIGHT_ROUND_BRACKET

// ---------------------------------------------------------
// Summation and Product across domain members
// 
// sum(dimension, tuple_position, expr) 
// prod(dimension, tuple_position, expr)
// ---------------------------------------------------------
dimension_reference: NAME
sum: "sum" LEFT_ROUND_BRACKET dimension_reference "," TUPLE_POSITION "," equation_expression RIGHT_ROUND_BRACKET
product: "prod" LEFT_ROUND_BRACKET dimension_reference "," TUPLE_POSITION "," equation_expression RIGHT_ROUND_BRACKET
