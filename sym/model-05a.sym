// Minimal example with an exogenous variable.

set time (t0) 'time';
set regions (USA) 'United States' ;
set sectors (a1) 'Sector 1' ;
set goods (g1) 'Good 1' ;

variable EXCH(regions) 'nominal exchange rate' stl,idx ;
variable EXCL(regions) 'nominal exchange rate - lagged' sta,idx ;

EXCH = 0 ;
lead(EXCL) = EXCH ;