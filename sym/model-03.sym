// Minimal example with an exogenous variable.

set time (t0) 'time';
set regions (USA) 'United States' ;
set sectors (a1) 'Sector 1' ;
set goods (g1) 'Good 1' ;

variable cap(regions) 'capital' sta,gdp ;
variable stuff(regions) 'stuff' end,gdp ;

lead(cap) = cap ;
stuff=cap ;

set all_regions = regions + (AUS, GBR, ROW) ;

set some_regions = all_regions(AUS, GBR) ;

set all_regions2 = all_regions ;
