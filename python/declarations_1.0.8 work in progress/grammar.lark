// ---------- Lexer ----------

%import common.CNAME -> NAME
%import common.ESCAPED_STRING
%import common.WS_INLINE
%import common.NEWLINE

%ignore WS_INLINE
%ignore NEWLINE

// Line comments (allow both shell-style and C++-style comments)
%ignore /#[^\n]*/
%ignore /\/\/[^\n]*/

// Triple-quoted doc string (non-greedy, spans lines)
TRIPLE_STRING: /\"\"\"(.|\n|\r)*?\"\"\"/

// ---------- Parser ----------

start: declaration+

declaration: member_decl                -> other_decl
           | category_decl
           | dimension_decl
           | dimensions_decl            -> other_decl
           | parameter_decl             -> other_decl
           | variable_decl              -> other_decl
           | equation_decl              -> other_decl

member_decl:     "member"    NAME ":" label doc?
category_decl:   "category"  NAME ":" label member_list? doc?
dimension_decl:  "dimension" NAME ":" label dimension_expression? doc?

// If these are placeholders for future constructs, keep them distinct:
dimensions_decl: "dimensions" NAME ":" label doc?
parameter_decl:  "parameter"  NAME ":" label units doc?
variable_decl:   "variable"   NAME ":" label units deviation_units dimensions_decl dimension_constraints logged? intertemporal_constant? doc?
equation_decl:   "equation"   NAME ":" label equation_expression doc?

units: "units" "=" NAME
deviation_units: "deviation_units" "=" NAME

logged: ["logged" ["=" ("true"|"false")] ]?

intertemporal_constant: ["intertemporal" ["=" ("true"|"false")] ]?

label: ESCAPED_STRING
doc: TRIPLE_STRING

// Dimension member expressions
dimension_expression: dimension_term (DIMENSION_OPERATOR dimension_term)*

DIMENSION_OPERATOR: "+" | "-"

// A dimension_term is either a bracketed list of member names or 
// a reference to a previously-declared dimension by its NAME.
dimension_term: dimension_list
        | NAME -> dimension_reference

// Bracketed list of dimension names (order matters)
dimension_list: "[" [NAME ("," NAME)*] "]"

// Bracketed list of member names (order matters)
member_list: "[" [NAME ("," NAME)*] "]"

dimension_constraints: "to be completed"

// Equation expressions
equation_expression: "to be completed"
