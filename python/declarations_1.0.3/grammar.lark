// grammar.lark — 'dimension' and 'category' may carry member lists (NAMEs only).
// Types are lower-case: member | dimension | dimensions | domain | parameter | variable | equation | category

start: declaration+

declaration: dim_or_cat_decl
           | other_decl

// dimension/category: may optionally include an ordered list of NAMEs
dim_or_cat_decl: (TYPE_DIMENSION | TYPE_CATEGORY) NAME ":" label dimension_values? doc?   -> decl

// all other types: NO dimension_values here
other_decl: (TYPE_MEMBER
           | TYPE_DIMENSIONS
           | TYPE_DOMAIN
           | TYPE_PARAMETER
           | TYPE_VARIABLE
           | TYPE_EQUATION) NAME ":" label doc?                                          -> decl

// ----- Pieces -----
label: ESCAPED_STRING
doc:   TRIPLE_STRING

// Ordered set of values in brackets (names only; no strings)
dimension_values: "[" NAME ("," NAME)* "]"

// ----- Terminals (all lower-case keywords) -----
TYPE_MEMBER: "member"
TYPE_DIMENSION: "dimension"
TYPE_DIMENSIONS: "dimensions"
TYPE_DOMAIN: "domain"
TYPE_PARAMETER: "parameter"
TYPE_VARIABLE: "variable"
TYPE_EQUATION: "equation"
TYPE_CATEGORY: "category"

// Identifiers
NAME: /[A-Za-z_]\w*/

// Separators: newline or ';' anywhere
SEP: /[\r\n]+/
%ignore SEP

// Triple-quoted Markdown block
TRIPLE_STRING: /\"\"\"(.|\n)*?\"\"\"/

%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE
