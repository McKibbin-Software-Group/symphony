// Grammar for declared names with short labels and markdown documentation.

start: declaration+          // <- no SEP here

declaration: NAME label doc?   -> decl

label: ESCAPED_STRING
doc:   TRIPLE_STRING

SEP: /[;\r\n]+/
%ignore SEP                   // <- ignore separators globally

TRIPLE_STRING: /\"\"\"(.|\n)*?\"\"\"/

%import common.CNAME           -> NAME
%import common.ESCAPED_STRING
%import common.WS_INLINE
%ignore WS_INLINE