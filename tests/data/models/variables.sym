member energy: "energy"
member mining: "mining"
member agriculture: "agriculture"
member durable_manufacturing: "durable manufacturing"
member nondurable_manufacturing: "nondurable manufacturing"

category sectors: "All sectors" 
    [energy, mining, agriculture, durable_manufacturing, nondurable_manufacturing, services] """All sectors"""

member USA: "USA"
member AUS: "Australia"
member ROW: "Rest of World"

category regions: "All regions of the World" 
    [USA, AUS, ROW]

dimension origins: "Origin regions" 
    regions

dimension destinations: "Destination regions" 
    regions

domain product_of_colours_and_regions: "All colours for all regions" 
    (colours, regions) 
    """All colours for all regions"""

domain bilateral: "Bilateral flows" 
    (origins, destinations | 1 != 2) 
    """Bilateral trade flows"""

domain bilateral_by_sector: "Bilateral flows by sector" 
    (sectors, origins, destinations | 2 != 3) 
    """Bilateral trade flows by sector"""

unit percent: "percent"
unit gdp: "gdp" """percent of GDP in the first projection year"""
unit percent_of_gdp: "percent of GDP" """percent of GDP"""

parameter depreciation_rate: "Depreciation rate" 
    domain=regions 
    unit=percent 
    """Depreciation rate for capital stock in all sectors"""

variable bilateral_imports: "Bilateral imports" 
    domain=bilateral_by_sector 
    unit=gdp
    deviation_unit=percent_of_gdp
    logged=True
    """Bilateral imports from origin to destination region, by sector"""

