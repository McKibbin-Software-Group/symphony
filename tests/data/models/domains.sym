member energy: "energy"
member mining: "mining"
member agriculture: "agriculture"
member manufacturing: "manufacturing"
member services: "services"

category sectors: "All sectors" 
    [energy, mining, agriculture, manufacturing, services] 
"""All sectors"""

member USA: "USA"
member AUS: "Australia"
member ROW: "Rest of World"

category regions: "All regions of the World" [
    USA,
    AUS,
    ROW
]

dimension not_USA: "All regions except the USA"
    regions - [USA]
    
dimension origins: "Origin regions" 
    regions 

dimension destinations: "Destination regions" 
    regions

domain regions_domain: "All regions" 
    (regions) 
"""All regions"""

domain product_of_colours_and_regions: "All colours for all regions" 
    (colours, regions) 
"""All colours for all regions"""

domain bilateral_trade: "Bilateral trade flows" 
    (origins, destinations | 1 != 2) 
"""Bilateral trade flows"""

domain origins_to_destinations: "trade flows"
    (origins,destinations - origins,destinations|1=2)

domain bilateral_trade_by_sector: "Bilateral trade flows by sector" 
    (sectors, origins, destinations | 2 != 3) 
"""Bilateral trade flows by sector"""

domain sectors_by_region: "Each sector for each region" 
    (sectors, regions)

domain mining_manufacturing: "Mining and manufacturing sectors" 
    ([mining, manufacturing]) 

domain mining_domain: "Mining sector" 
    (mining_manufacturing - [manufacturing])

domain mining_domain_2: "Mining sector"
    (mining_domain)