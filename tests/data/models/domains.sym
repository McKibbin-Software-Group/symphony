include "dimensions.sym"

domain regions_domain: "All regions" 
    (regions) 
"""All regions"""

domain product_of_colours_and_regions: "All colours for all regions" 
    (colours, regions) 
"""All colours for all regions"""

domain region_pairs: "Bilateral trade flows" 
    (origins, destinations) 
"""All pairs of origin and destination regions"""

domain bilateral_trade: "Bilateral trade flows" 
    (origins, destinations | 1 != 2) 
"""Bilateral trade flows"""

domain matched_origins_to_destinations: "trade flows"
    (origins,destinations|1=2)

domain bilateral_trade_by_sector: "Bilateral trade flows by sector" 
    (sectors, origins, destinations | 2 != 3) 
"""Bilateral trade flows by sector"""



domain sectors_by_region: "Each sector for each region" 
    (sectors, regions)

domain mining_manufacturing: "Mining and manufacturing sectors" 
    (sectors - [energy, services, agriculture]) 

domain mining_domain: "Mining sector" 
    (mining_manufacturing - [manufacturing])

domain mining_domain_2: "Mining sector"
    (mining_domain)
