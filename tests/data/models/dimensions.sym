member red: "Red colour"
member green: "Green colour"
member blue: "Blue colour"

category colours: "All colours" [red, green, blue] """All the available colours"""

member USA: "USA"
member AUS: "Australia"
member ROW: "Rest of World"

category regions: "All regions of the World" [
    USA,
    AUS,
    ROW
]

dimension colour: "Available colours" [red, green, blue] """All the available colours defined as an explicit dimension"""

dimension fixed: "Just Red and Green" [red, green]

dimension red_green: "Red and Green by subtracting Blue from All Colours" colours - [blue]

dimension red_blue: "Red and Blue by subtracting Green from All Colours" colours - [green]

dimension red: "Red by subtracting Blue from red_blue" red_blue - [blue]

dimension blue_only: "Blue only" [blue]

dimension rgb: "Red Green and Blue" red_green + blue_only

dimension red_green_blue: "Red and green and blue via addition" [red] + blue_only + red_green

// dimensions colours_regions: "All colours for all regions" [colours, regions] """All colours for all regions"""