include "categories.sym"

dimension not_USA: "All regions except the USA"
    regions - [USA]
    """
    Example documentation for the dimension that is all regions except the USA.
    """

dimension red_green: "Red and Green by subtracting Blue from All Colours" 
    colours - [blue]

dimension red_blue: "Red and Blue by subtracting Green from All Colours" 
    colours - [green]

dimension red: "Red by subtracting Blue from red_blue" 
    red_blue - [blue]

dimension blue_only: "Blue only" 
    [blue]

dimension rgb: "Red Green and Blue" 
    red_green + blue_only

dimension red_green_blue: "Red and green with blue via addition" 
    [red] + blue_only + red_green
