include "variables.sym"

equation: "Sum of investment across sectors for sector investment"
    INVP = sum(sectors|INV(agg=sectors:1))

equation: "Global total sector investment"
    INVPW = sum(regions| sum(sectors|INV(agg=sectors:1,regions:2)))

equation: "Total investment aggregation"
    INVT = INVP + INVY + INVZ
    """
    Total investment is the sum of investment across all sectors 
    including the sectors that produce raw and household capital
    """

equation: "Ensure global remittances sum to zero"
    REMITU = - sum(not_USA | REMIT(agg=not_USA:1))
    """
    USA remittances are the negative sum of remittances by other regions.
    """

equation: "Nominal effective exchange rate"
    NEER = - sum(origins | eer_weight(agg=origins:1)*(EXCH(agg=origins:1) - EXCH) )

equation: "exchange rate conversion of source price to landed destination price"
    PIM = PRX(dim=origins:2) + EXCH(dim=origins:1) - EXCH(dim=destinations:1)
    """
    This is an example of the syntax used to match up the dimensions from the LHS variable
    to the dimensions of the RHS variables.
    """
