{
  "scopeName": "source.symphony",
  "name": "Symphony",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#booleans"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#brackets"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.symphony",
          "match": "#.*$"
        },
        {
          "name": "comment.line.double-slash.symphony",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.triple.symphony",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.symphony",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.symphony",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.symphony",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.symphony",
          "match": "\\b(sum|prod)\\b"
        },
        {
          "name": "storage.type.declaration.symphony",
          "match": "\\b(domain|member|category|dimension|parameter|variable|unit|deviation_unit|equation|logged|intertemporal)\\b"
        },
        {
          "name": "keyword.operator.comparison.symphony",
          "match": "!=|="
        },
        {
          "name": "keyword.operator.arithmetic.symphony",
          "match": "\\+|-"
        },
        {
          "name": "keyword.operator.other.symphony",
          "match": "\\|"
        }
      ]
    },
    "booleans": {
      "patterns": [
        {
          "name": "constant.language.boolean.symphony",
          "match": "\\b(True|true|False|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.symphony",
          "match": "\\b[0-9]+(\\.[0-9]+)?\\b"
        }
      ]
    },
    "brackets": {
      "patterns": [
        {
          "name": "punctuation.section.brackets.symphony",
          "match": "[\\[\\]\\(\\)]"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.constant.symphony",
          "match": "\\b[A-Z][A-Z0-9_]*\\b"
        },
        {
          "name": "variable.other.symphony",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}